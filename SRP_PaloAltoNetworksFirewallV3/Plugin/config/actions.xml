<?xml version="1.0" encoding="utf-8"?>
<remv1:Remediation-Plugin xmlns:remv1="RemediationVersion1.xsd" Name="Palo Alto Networks Firewall V3" Guid="d369ed00-89c7-49d6-9cdf-49922954cb17" Version="3" IsLogRhythmPlugin="true">
  <!-- ########## Configuration Action ########## -->
  <remv1:Action Name="Create PAN Firewall V3 Configuration File" Command="pwsh">
    <remv1:ConstantParameter Name="Script" Switch="-file Config.ps1" Order="1" />
    <remv1:StringParameter Name="PAN Firewall IP*" Switch="-PANFirewallIP" Order="2" />
    <remv1:StringParameter Name="Virtual System Name*" Switch="-VsysName" Order="3" />
    <remv1:StringParameter Name="PAN Firewall UserName*" Switch="-UserName" Order="4" />
    <remv1:StringParameter Name="PAN Firewall Version*" Switch="-PANVersion" Order="5" />
    <remv1:EncryptedParameter>
      <remv1:StringParameter Name="PAN Firewall Password*" Switch="-Password" Order="6" />
    </remv1:EncryptedParameter>
    <remv1:EncryptedParameter>
      <remv1:StringParameter Name="Proxy Url(http://ip:port)" Switch="-ProxyUrl" Order="7" />
    </remv1:EncryptedParameter>
    <remv1:StringParameter Name="Proxy Username" Switch="-ProxyUname" Order="8" />
    <remv1:EncryptedParameter>
      <remv1:StringParameter Name="Proxy Password" Switch="-ProxyPasswd" Order="9" />
    </remv1:EncryptedParameter>
  </remv1:Action>
  <!-- ########## Add IP to group ########## -->
  <remv1:Action Name="Add IP to Group" Command="pwsh">
    <remv1:ConstantParameter Name="Script" Switch="-file AddIPToGroup.ps1" Order="1" />
    <remv1:StringParameter Name="IP*" Switch="-IP" Order="2" />
    <remv1:StringParameter Name="Group Name*" Switch="-GroupName" Order="3" />
  </remv1:Action>
  <!-- ########## Add FQDN to group ########## -->
  <remv1:Action Name="Add FQDN to Group" Command="pwsh">
    <remv1:ConstantParameter Name="Script" Switch="-file AddFQDNToGroup.ps1" Order="1" />
    <remv1:StringParameter Name="FQDN*" Switch="-FQDN" Order="2" />
    <remv1:StringParameter Name="Group Name*" Switch="-GroupName" Order="3" />
  </remv1:Action>
  <!-- ########## Add URL Filter ########## -->
  <remv1:Action Name="Add URL Filter" Command="pwsh">
    <remv1:ConstantParameter Name="Script" Switch="-file UrlFilter.ps1" Order="1" />
    <remv1:StringParameter Name="URL Block Categories*" Switch="-URLBlockList" Order="2" />
    <remv1:StringParameter Name="Filter Name*" Switch="-FilterName" Order="3" />
    <remv1:StringParameter Name="Description" Switch="-Description" Order="4" />
  </remv1:Action>
</remv1:Remediation-Plugin>